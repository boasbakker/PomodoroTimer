{
    "manifest_version": 3,
    "name": "Zen Pomodoro Tab",
    "version": "1.0.0",
    "description": "A permanent Pomodoro timer tab that stays pinned at the end of the pinned list.",
    "permissions": [
        "tabs",
        "storage"
    ],
    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },
    "icons": {
        "48": "icons/icon.svg",
        "96": "icons/icon.svg"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "zen-pomodoro@local",
            "strict_min_version": "109.0"
        }
    }
}
